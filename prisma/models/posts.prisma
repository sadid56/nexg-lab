model Post {
  id         String     @id @default(cuid())
  title      String
  slug       String     @unique
  content    String
  coverImage String?
  authorId   String
  feedbacks  Feedback[]
  reactions  Reaction[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?
}
