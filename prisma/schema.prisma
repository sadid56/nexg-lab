generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  tags         String[]
  coverImage   String?
  descriptions String
  status       Status     @default(pending)
  feedbacks    Feedback[]
  reactions    Reaction[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  readTime     Int
  userId       String?
  content      String
  category     String
}

model Category {
  id        String   @id @default(cuid())
  title     String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  status    Status   @default(pending)
  updatedAt DateTime @updatedAt
}

enum BlockType {
  INFO
  WARNING
  ERROR
  TIPS
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Keywords {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean
  image         String?
  role          Role       @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  banned        Boolean    @default(false)
  banReason     String?
  feedbacks     Feedback[]
  reactions     Reaction[]
  accounts      account[]
  sessions      session[]
}

enum Status {
  pending
  active
  unactive
}

enum Role {
  USER
  ADMIN
}
