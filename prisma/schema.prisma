generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String?    @unique
  feedbacks Feedback[]
  reactions Reaction[]
}

model Post {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  tags         String[]
  coverImage   String?
  descriptions String
  status       Status     @default(pending)
  feedbacks    Feedback[]
  reactions    Reaction[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sections     Section[]
  userId       String?
  category     String
}

model Section {
  id       String  @id @default(cuid())
  postId   String
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  markdown String
  blocks   Block[]
}

model Category {
  id        String   @id @default(cuid())
  title     String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  status    Status   @default(pending)
  updatedAt DateTime @updatedAt
}

model Block {
  id        String    @id @default(cuid())
  type      BlockType
  content   String?
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

enum BlockType {
  INFO
  WARNING
  ERROR
  TIPS
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Keywords {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

enum Status {
  pending
  active
  unactive
}
